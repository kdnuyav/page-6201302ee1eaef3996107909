late-columns:1fr 1fr}\n  .mag-grid>div:first-child{grid-column:1/-1}\n  .steps,.clients{grid-template-columns:1fr 1fr}\n}\n@media(max-width:620px){\n  .mag-grid,.steps,.clients,.faq-grid{grid-template-columns:1fr}\n  section{padding:56px 0}\n}\n</style><main>\n\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <nav class=\"tagrow\" aria-label=\"页内导航\">\n      <span class=\"brandmark\">我爱嘉源</span>\n      <a href=\"#how\">上手</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n\n    <div class=\"mag-grid\">\n      <div>\n        <p class=\"kicker\">JIAYUAN · SINCE DAY ONE</p>\n        <h1>我爱<em>嘉源</em></h1>\n        <div class=\"lede\">\n          <p>一个把价格写在明处的地方。</p>\n          <p>三档套餐。按月付，或按年付。没有隐藏项。</p>\n        </div>\n        <div class=\"hero-foot\">\n          <a class=\"btn btn-a\" href=\"#plans\">直接看价格</a>\n          <a class=\"btn btn-b\" href=\"#how\">先看怎么上手</a>\n        </div>\n      </div>\n\n      <div class=\"col-note\">\n        <h2>本期速览</h2>\n        <ul>\n          <li><span>起步价</span><b>¥15/月</b></li>\n          <li><span>年付优惠</span><b>省两个月</b></li>\n          <li><span>设备数</span><b>3 – 20 台</b></li>\n          <li><span>月流量</span><b>100GB 起</b></li>\n          <li><span>工单支持</span><b>旗舰版起</b></li>\n        </ul>\n      </div>\n\n      <aside class=\"col-quote\">\n        <p class=\"q\">“少点套路。<span>多点确定。</span>”</p>\n        <p>这是我们写套餐页时唯一的原则：你看到的，就是你付的。流量、设备数、价格，全部摊开。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n\n\n<section id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">01</span>\n      <h2>三步上手</h2>\n      <p>从注册到使用，不超过五分钟。以下是完整流程。</p>\n    </div>\n    <div class=\"steps\">\n      <article class=\"step\">\n        <p class=\"n\">1</p>\n        <h3>注册账号</h3>\n        <p>打开官网，用邮箱注册。设置密码。登录后进入用户中心。</p>\n      </article>\n      <article class=\"step\">\n        <p class=\"n\">2</p>\n        <h3>选择套餐</h3>\n        <p>对照下方表格选一档。按月付先试，合适再转年付。支付后即时生效。</p>\n      </article>\n      <article class=\"step\">\n        <p class=\"n\">3</p>\n        <h3>导入使用</h3>\n        <p>在用户中心复制订阅信息，导入你的客户端。完成后即可开始使用。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">02</span>\n      <h2>套餐对比</h2>\n      <p>三档。按月或按年。年付相当于付十个月，用十二个月。</p>\n    </div>\n\n    <div class=\"table-scroll\">\n      <table>\n        我爱嘉源全部在售套餐，权益逐项对照。\n        <thead>\n          <tr>\n            <th>项目</th>\n            <th>\n              <span class=\"pname\">基础版</span>\n              <span class=\"pprice\">¥15/月</span>\n            </th>\n            <th class=\"hot\">\n              <span class=\"pname\">旗舰版</span>\n              <span class=\"pprice\">¥35/月</span>\n            </th>\n            <th>\n              <span class=\"pname\">团队版</span>\n              <span class=\"pprice\">¥85/月</span>\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th>按年付</th>\n            <td>¥150/年<span class=\"yr\">折合 ¥12.5/月</span></td>\n            <td>¥350/年<span class=\"yr\">折合 ¥29.2/月</span></td>\n            <td>¥850/年<span class=\"yr\">折合 ¥70.8/月</span></td>\n          </tr>\n          <tr>\n            <th>每月流量</th>\n            <td>100GB</td>\n            <td>300GB</td>\n            <td>1000GB</td>\n          </tr>\n          <tr>\n            <th>同时在线设备</th>\n            <td>3 台</td>\n            <td>5 台</td>\n            <td>20 台</td>\n          </tr>\n          <tr>\n            <th>流媒体</th>\n            <td>基础流媒体解锁</td>\n            <td>全节点原生流媒体解锁</td>\n            <td>全节点原生流媒体解锁</td>\n          </tr>\n          <tr>\n            <th>线路</th>\n            <td>普通线路节点池</td>\n            <td>IPLC 专线游戏加速优化</td>\n            <td>VIP 专属高带宽节点</td>\n          </tr>\n          <tr>\n            <th>定制能力</th>\n            <td>—</td>\n            <td>—</td>\n            <td>支持企业定制路由</td>\n          </tr>\n          <tr>\n            <th>支持服务</th>\n            <td>标准工单</td>\n            <td>7×24 优先工单</td>\n            <td>专属客户经理</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n    <p class=\"plans-note\">说明：流量按自然月重置。设备数指同时在线上限。套餐到期后不自动续费，需手动续订。</p>\n  </div>\n</section>\n\n\n<section id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">03</span>\n      <h2>客户端</h2>\n      <p>覆盖常见平台。在用户中心复制订阅信息，导入对应客户端即可。</p>\n    </div>\n    <div class=\"clients\">\n      <article class=\"client\">\n        <h3><span>桌面</span>Windows / macOS</h3>\n        <p>在用户中心复制订阅信息，粘贴进你常用的桌面客户端，更新订阅后选择节点。具体下载地址以用户中心内提供的为准。</p>\n        <a href=\"#how\">查看导入步骤 →</a>\n      </article>\n      <article class=\"client\">\n        <h3><span>移动</span>iOS / Android</h3>\n        <p>手机端同样使用订阅导入。iOS 与 Android 各自适用的客户端清单，登录用户中心后可见。</p>\n        <a href=\"#how\">查看导入步骤 →</a>\n      </article>\n      <article class=\"client\">\n        <h3><span>其他</span>路由器 / 更多设备</h3>\n        <p>团队版用户可咨询企业定制路由方案。其他设备的配置方法，以用户中心文档为准。</p>\n        <a href=\"#faq\">先看常见问题 →</a>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">04</span>\n      <h2>常见问题</h2>\n      <p>付款前看一眼。付款后也看一眼。</p>\n    </div>\n    <div class=\"faq-grid\">\n      <article class=\"faq\">\n        <h3>流量用完了怎么办？</h3>\n        <p>当月流量用完后，可以等次月 1 日自动重置，或在用户中心升级到更高档位。升级后流量额度按新套餐执行。</p>\n      </article>\n      <article class=\"faq\">\n        <h3>月付能转年付吗？</h3>\n        <p>可以。在用户中心选择同一档位的年付方案即可。年付价格为 <b>10 个月费用，使用 12 个月</b>。</p>\n      </article>\n      <article class=\"faq\">\n        <h3>设备数是怎么算的？</h3>\n        <p>按<b>同时在线</b>的设备数量计算。例如基础版 3 台：手机、电脑、平板可以同时在线，第 4 台需要等其中一台断开。</p>\n      </article>\n      <article class=\"faq\">\n        <h3>套餐之间能切换吗？</h3>\n        <p>可以。在用户中心发起变更。升档即时生效；降档在当前计费周期结束后生效。</p>\n      </article>\n      <article class=\"faq\">\n        <h3>支持哪些客户端？</h3>\n        <p>Windows、macOS、iOS、Android 均可通过订阅方式导入。具体客户端清单与配置方法，登录用户中心后查看。</p>\n      </article>\n      <article class=\"faq\">\n        <h3>遇到问题找谁？</h3>\n        <p>在用户中心提交工单。旗舰版为 7×24 优先工单；团队版配有专属客户经理，可直接对接。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span class=\"fb\">我爱嘉源</span>\n    <span>价格公开 · 权益写明 · 到期手动续订</span>\n  </div>\n</footer>",
